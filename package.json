{
    "name": "pxt-microbit",
    "version": "9.1.1",
    "description": "micro:bit target for Microsoft MakeCode (PXT)",
    "keywords": [
        "JavaScript",
        "education",
        "microbit"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/pxt-microbit.git"
    },
    "author": "",
    "license": "MIT",
    "homepage": "https://github.com/microsoft/pxt-microbit#readme",
    "engines": {
        "node": "22.23.1",
        "npm": "11.18.0"
    },
    "packageManager": "npm@11.18.0",
    "scripts": {
        "build:target": "pxt buildtarget",
        "test:inkybit-codec": "node node_modules/typescript/bin/tsc -p tests/inkybit-codec && node tests/inkybit-codec/codec.test.js",
        "test:inkybit-integration": "pxt buildtarget && cd tests/inkybit-integration && ../../node_modules/.bin/pxt install && ../../node_modules/.bin/pxt build"
    },
    "files": [
        "README.md",
        "pxtarget.json",
        "targetconfig.json",
        "built/*.js",
        "built/*.json",
        "built/*.d.ts",
        "built/hexcache",
        "built/web",
        "sim/public",
        "docs/*.md",
        "docs/*/*.md",
        "docs/*/*/*.md",
        "docs/static/*.svg",
        "docs/static/*.png",
        "docs/static/icons/favicon.ico"
    ],
    "devDependencies": {
        "@types/dom-mediacapture-record": "1.0.20",
        "@types/marked": "0.3.0",
        "@types/node": "8.10.66",
        "@types/react": "16.4.7",
        "@types/react-dom": "16.0.3",
        "@types/web-bluetooth": "0.0.4",
        "less": "3.13.1",
        "react": "16.8.3",
        "react-dom": "16.11.0",
        "semantic-ui-less": "2.4.1",
        "typescript": "4.8.3",
        "pxt": "0.5.1"
    },
    "dependencies": {
        "pxt-common-packages": "14.0.2",
        "pxt-core": "13.0.1"
    },
    "overrides": {
        "@blockly/field-grid-dropdown": {
            "blockly": "13.1.1"
        },
        "@blockly/plugin-workspace-search": {
            "blockly": "13.1.1"
        }
    }
}
